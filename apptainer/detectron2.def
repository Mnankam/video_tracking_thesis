Bootstrap: docker
From: pytorch/pytorch:2.1.2-cuda11.8-cudnn8-runtime

%post
    export DEBIAN_FRONTEND=noninteractive

    # -----------------------------
    # Zeitzone
    # -----------------------------
    ln -fs /usr/share/zoneinfo/Europe/Berlin /etc/localtime
    echo "Europe/Berlin" > /etc/timezone

    # -----------------------------
    # Systempakete
    # -----------------------------
    apt-get update && apt-get install -y \
        build-essential \
        git \
        cmake \
        ninja-build \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
      ffmpeg \
        tzdata \
        && rm -rf /var/lib/apt/lists/*

    # -----------------------------
    # Python Setup
    # -----------------------------
    python -m pip install --upgrade pip wheel
    python -m pip install "setuptools<81" cython packaging

    # -----------------------------
    # Stabile Python Libraries
    # -----------------------------
    python -m pip install \
        "numpy<2" \
        pillow==9.5.0 \
        pandas==2.1.4 \
        matplotlib==3.8.2 \
        pyyaml==6.0.1 \
        scipy==1.11.4 \
        scikit-image==0.22.0 \
        imageio==2.33.1 \
        filterpy==1.4.5 \
        lap==0.5.13 \
        tqdm==4.66.1 \
        rich==13.7.0 \
        loguru==0.7.2 \
        scikit-learn==1.3.2 \
        opencv-python-headless==4.8.1.78

    # -----------------------------
    # Checks
    # -----------------------------
    python -c "import torch; print('Torch:', torch.__version__)"
    python -c "import cv2; print('OpenCV:', cv2.__version__)"
    python -c "import numpy; print('NumPy:', numpy.__version__)"

    # -----------------------------
    # Detectron2
    # -----------------------------
    python -m pip install --no-build-isolation  'git+https://github.com/facebookresearch/detectron2.git@v0.6'

    # -----------------------------
    # Final Check
    # -----------------------------
    python -c "import detectron2; print('Detectron2 OK')"

%environment
    export LC_ALL=C
    export LANG=C

%runscript
    exec python "$@"
